---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import Note from "../components/Note.astro";
import Scribble from "../components/Scribble.astro";
import { mission, pillars, team } from "../data/site";

const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .map((n) => n[0])
    .join("")
    .slice(0, 2);
---

<Layout title="About" description="Ellipsis Earth's mission, vision and team: scientists, drone pilots, data analysts and educators building an integrated ecosystem for environmental change.">
  <PageHero marker="About" title="An ecosystem for environmental change." intro={mission.goal} />

  {/* Vision, tied back to the three pillars */}
  <section class="on-page paper border-y-[1.5px] border-fg py-24 sm:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <p class="label lg:col-span-3">The vision</p>
      <div class="lg:col-span-9">
        <p class="reveal font-display text-[clamp(1.75rem,3.6vw,3rem)] leading-[1.12] font-semibold tracking-tight">{mission.vision}</p>
        <ul class="reveal-stagger mt-14 grid gap-6 sm:grid-cols-3">
          {
            pillars.map((p) => (
              <li class="border-t-[1.5px] border-fg pt-4">
                <p class="label text-mark">
                  {p.number} · {p.verb}
                </p>
                <a href={p.href} class="mt-2 block font-display text-3xl font-bold hover:underline">
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x grid gap-8 py-24 sm:py-32 lg:grid-cols-2">
    {
      team.leaders.map((p, i) => (
        <article class="card reveal flex flex-col gap-8 p-8 sm:flex-row sm:p-10" style={`rotate:${i ? 0.6 : -0.6}deg`}>
          {/* Hand-drawn monogram stands in for headshots, which belong to the real company. */}
          <div aria-hidden="true" class="relative grid size-28 shrink-0 place-items-center">
            <Scribble shape="circle" class="absolute inset-0 size-full" />
            <span class="font-display text-4xl font-bold">{initials(p.name)}</span>
          </div>
          <div>
            <p class="label text-mark">{p.role}</p>
            <h2 class="mt-3 text-4xl">{p.name}</h2>
            <p class="mt-5 text-muted">{p.bio}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="flip paper bg-bg py-24 text-fg sm:py-32">
    <div class="container-x">
      <SectionHead marker="The teams" title="The people behind the data." />
      <ol class="reveal-stagger mt-14 grid gap-px overflow-hidden rounded-lg border-[1.5px] border-fg bg-fg md:grid-cols-2 lg:grid-cols-4">
        {
          team.groups.map((g, i) => (
            <li class="bg-bg p-7">
              <span class="label text-muted">Team 0{i + 1}</span>
              <h3 class="mt-8 text-3xl">{g.name}</h3>
              <p class="mt-4 text-muted">{g.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-x py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <p class="label">Accelerator alumni</p>
      <Note rotate={-3}>where we grew up</Note>
    </div>
    <ul class="reveal-stagger mt-6 border-t-[1.5px] border-fg">
      {team.accelerators.map((a) => <li class="border-b border-line py-6 font-display text-3xl font-bold tracking-tight sm:text-4xl">{a}</li>)}
    </ul>
  </section>

  <CtaBand title="Work with us." body="Partnerships, research collaborations and press: we'd love to hear from you." cta="Get in touch" note="say hello" />
</Layout>
