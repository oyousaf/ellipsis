---
import Layout from "../layouts/Layout.astro";
import Note from "../components/Note.astro";
import { site } from "../data/site";

const interests = ["A litter survey", "Schools programme", "Partnership", "Press", "Something else"];
---

<Layout title="Contact" description="Talk to Ellipsis Earth about litter surveys, the Educate schools programme, partnerships or press.">
  <section class="graph margin-line relative overflow-hidden pt-36 pb-24 sm:pt-44">
    <div aria-hidden="true" class="absolute inset-0 bg-linear-to-b from-transparent to-bg"></div>
    <div class="container-x relative grid gap-16 lg:grid-cols-[1fr_1.15fr]">
      <div>
        <p class="label flex items-center gap-3"><span>Contact</span><span aria-hidden="true" class="h-px w-12 bg-current opacity-50"></span></p>
        <h1 class="display-lg mt-6">Let's talk data.</h1>
        <p class="mt-8 max-w-md text-lg text-muted">
          Councils, brands, schools, researchers or press: tell us what you're working on and the right person will get back to you.
        </p>
        <dl class="mt-12 space-y-6 border-t-[1.5px] border-fg pt-6">
          <div>
            <dt class="label text-muted">Email</dt>
            <dd class="mt-1 text-xl font-semibold"><a href={`mailto:${site.email}`} class="hover:text-mark">{site.email}</a></dd>
          </div>
          <div>
            <dt class="label text-muted">Based in</dt>
            <dd class="mt-1 text-xl font-semibold">{site.location}</dd>
          </div>
          <div>
            <dt class="label text-muted">Existing clients</dt>
            <dd class="mt-1 text-xl font-semibold"><a href={site.portalUrl} class="hover:text-mark">Client login →</a></dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <Note class="absolute -top-10 right-4 z-10" rotate={5}>we read every one</Note>
        <form method="post" action="/api/contact" data-contact-form class="card contact-form p-6 sm:p-10" style="rotate:0.6deg">
          <fieldset class="mb-8">
            <legend class="label mb-4 text-muted">I'm interested in</legend>
            <div class="flex flex-wrap gap-2">
              {
                interests.map((label, i) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="interest" value={label} checked={i === 0} class="peer sr-only" />
                    <span class="tag cursor-pointer text-[0.7rem]! transition peer-checked:bg-fg peer-checked:text-page peer-focus-visible:outline-2 peer-focus-visible:outline-mark peer-focus-visible:outline-dashed">
                      {label}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="grid gap-6 sm:grid-cols-2">
            <label class="field">
              <span class="label">Name</span>
              <input name="name" required autocomplete="name" maxlength="120" />
            </label>
            <label class="field">
              <span class="label">Email</span>
              <input name="email" type="email" required autocomplete="email" maxlength="200" />
            </label>
            <label class="field sm:col-span-2">
              <span class="label">Organisation <span class="normal-case opacity-70">(optional)</span></span>
              <input name="organisation" autocomplete="organization" maxlength="200" />
            </label>
            <label class="field sm:col-span-2">
              <span class="label">How can we help?</span>
              <textarea name="message" required minlength="10" maxlength="4000" rows="4"></textarea>
            </label>
            {/* Honeypot for bots; hidden from people and assistive tech. */}
            <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          </div>

          <label class="mt-6 flex items-start gap-3 text-sm text-muted">
            <input type="checkbox" name="consent" required class="mt-1 size-4" />
            I'm happy for Ellipsis Earth to contact me about this enquiry.
          </label>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-ink">Send message <span class="arrow" aria-hidden="true">→</span></button>
            <p data-form-status role="status" class="hand text-lg"></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
  }

  /* Ruled-line inputs, like writing on a notebook page. */
  .field input,
  .field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1.5px solid var(--color-fg);
    background: transparent;
    padding: 0.5rem 0.1rem;
    font-size: 1.05rem;
    color: var(--color-fg);
  }

  .field textarea {
    field-sizing: content;
    min-height: 6.5rem;
    resize: vertical;
    background-image: linear-gradient(transparent calc(1.9rem - 1px), var(--color-line) calc(1.9rem - 1px));
    background-size: 100% 1.9rem;
    line-height: 1.9rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-mark);
    border-bottom-width: 2.5px;
  }

  /* Only flag errors after the person has interacted with a field. */
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-bottom-color: var(--color-mark);
    border-bottom-style: dashed;
  }

  .contact-form:has(:user-invalid) [data-form-status]:empty::after {
    content: "check the highlighted fields";
  }
</style>

<script>
  // Progressive enhancement: the form also works as a plain POST + redirect without JS.
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");

  const params = new URLSearchParams(location.search);
  if (status && params.has("sent")) status.textContent = "Thanks! We'll be in touch soon.";
  if (status && params.has("error")) status.textContent = "Something went wrong. Please email us instead.";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    button?.setAttribute("disabled", "");
    status.textContent = "sending…";
    try {
      const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      const data = (await res.json()) as { ok: boolean; error?: string };
      if (!res.ok || !data.ok) throw new Error(data.error);
      form.reset();
      status.textContent = "Thanks! We'll be in touch soon.";
    } catch (err) {
      status.textContent = err instanceof Error && err.message ? err.message : "Something went wrong. Please email us instead.";
    } finally {
      button?.removeAttribute("disabled");
    }
  });
</script>
