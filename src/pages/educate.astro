---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import FieldPhoto from "../components/FieldPhoto.astro";
import Note from "../components/Note.astro";
import Scribble from "../components/Scribble.astro";
import { educate, photos } from "../data/site";
---

<Layout
  title="Educate: citizen science for schools"
  description="Plastics, Data & Me: an online citizen science programme where students design surveys, collect real litter data and share their findings."
>
  <PageHero marker="§ 02 · Educate · Teach" title="Real science. Real data. Real students." intro={educate.intro}>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/contact" class="btn btn-ink">Register your school <span class="arrow" aria-hidden="true">→</span></a>
      <a href="#educators" class="btn btn-line">For educators</a>
    </div>
  </PageHero>

  {/* The programme, in Ellipsis Educate's own words */}
  <section class="container-x grid items-center gap-16 py-20 sm:py-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SectionHead marker="The programme" title={educate.course} />
      {educate.about.map((p) => <p class="reveal mt-6 max-w-2xl text-lg">{p}</p>)}
      <dl class="reveal-stagger mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          educate.numbers.map((n) => (
            <div class="border-t-[1.5px] border-fg pt-3">
              <dt class="sr-only">{n.label}</dt>
              <dd class="font-display text-6xl font-bold">
                <span data-count={n.value}>{n.value}</span>
              </dd>
              <dd aria-hidden="true" class="text-sm text-muted">
                {n.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="relative lg:col-span-5">
      <FieldPhoto src={photos.students.src} alt={photos.students.alt} fig="05" caption="Fieldwork with the Ellipsis Earth app." rotate={2} width={820} height={680} />
      <Note class="absolute -bottom-14 -left-4" rotate={-4}>same tech as our scientists</Note>
    </div>
  </section>

  {/* Six-step journey on a cream page, as a horizontal scroll-snap track */}
  <section class="on-page paper overflow-hidden border-y-[1.5px] border-fg py-24 sm:py-28">
    <div class="container-x flex flex-wrap items-end justify-between gap-6">
      <SectionHead marker="How it works" title="Six steps from curious to citizen scientist." />
      <p class="hand text-2xl" style="rotate:-2deg">scroll sideways →</p>
    </div>
    <ol class="mt-14 flex snap-x snap-mandatory gap-6 overflow-x-auto px-[max(1rem,calc((100vw-82rem)/2+2rem))] pt-2 pb-8 scrollbar-thin">
      {
        educate.journey.map((j, i) => (
          <li class="card flex w-[min(78vw,20rem)] shrink-0 snap-start flex-col p-7" style={`rotate:${i % 2 ? 1 : -1}deg`}>
            <span class="font-display text-7xl font-bold text-mark">{i + 1}</span>
            <h3 class="mt-8 text-4xl">{j.title}</h3>
            <p class="mt-3 text-muted">{j.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* Students & educators */}
  <section class="container-x grid gap-8 py-24 sm:py-32 md:grid-cols-2">
    <article id="students" class="card reveal p-8 sm:p-10" style="rotate:-0.6deg">
      <p class="label text-mark">For students</p>
      <h2 class="mt-4 text-5xl">Become an Ellipsis Earth scientist.</h2>
      <ul class="mt-8 space-y-4">
        {educate.forStudents.map((s) => <li class="flex gap-3"><Scribble shape="tick" class="mt-1 h-4 w-5 shrink-0" />{s}</li>)}
      </ul>
    </article>
    <article id="educators" class="card reveal p-8 sm:p-10" style="rotate:0.6deg">
      <p class="label text-mark">For educators</p>
      <h2 class="mt-4 text-5xl">Everything ready to teach.</h2>
      <ul class="mt-8 space-y-4">
        {educate.forEducators.map((s) => <li class="flex gap-3"><Scribble shape="tick" class="mt-1 h-4 w-5 shrink-0" />{s}</li>)}
      </ul>
      <p class="label mt-10 text-muted">Curriculum aligned</p>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {educate.curriculum.map((c) => <li class="tag">{c}</li>)}
      </ul>
    </article>
  </section>

  {/* Impact + testimonials */}
  <section class="flip paper bg-bg py-24 text-fg sm:py-32">
    <div class="container-x">
      <p class="reveal mx-auto max-w-4xl text-center font-display text-[clamp(2rem,4.5vw,3.75rem)] leading-[1.05] font-bold tracking-tight">
        <span class="hand text-[1.15em]">100%</span> of students across 50 schools said they felt like real scientists, and would sign up again.
      </p>
      <div class="reveal-stagger mt-20 columns-1 gap-6 md:columns-2 lg:columns-4">
        {
          educate.testimonials.map((t, i) => (
            <figure class="card mb-6 break-inside-avoid p-6" style={`rotate:${[-1.2, 0.8, -0.4, 1.1][i]}deg; color-scheme: light`}>
              <blockquote class="font-serif text-lg leading-relaxed">“{t.quote}”</blockquote>
              <figcaption class="mt-6">
                <span class="font-semibold">{t.name}</span>
                <span class="label mt-1 block text-muted">{t.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-x grid gap-12 py-24 sm:py-32 lg:grid-cols-[1fr_1.6fr]">
    <SectionHead marker="FAQs" title="Before you sign up." />
    <div class="reveal"><Faq items={educate.faqs} group="educate-faq" /></div>
  </section>

  <CtaBand
    title="Bring real science into your classroom."
    body="Tell us about your school and we'll set up a teacher information session and a free trial."
    cta="Register interest"
    note="free trial!"
  />
</Layout>
