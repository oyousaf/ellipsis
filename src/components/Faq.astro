---
interface Props {
  items: { q: string; a: string }[];
  // Shared name makes the accordion exclusive: opening one closes the others.
  group: string;
}

const { items, group } = Astro.props;
---

<div class="border-t-[1.5px] border-fg">
  {
    items.map((item, i) => (
      <details class="faq border-b border-line" name={group} open={i === 0}>
        <summary class="flex items-center gap-5 py-5 text-lg font-semibold sm:text-xl">
          <span class="label w-8 shrink-0 text-muted">Q{i + 1}</span>
          <span class="flex-1">{item.q}</span>
          <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-md border-[1.5px] border-fg text-xl leading-none">+</span>
        </summary>
        <p class="max-w-2xl pb-6 pl-13 text-muted">{item.a}</p>
      </details>
    ))
  }
</div>
