---
interface Props {
  class?: string;
  // Animate the dots continuously (the "typing" ellipsis), rather than only on hover.
  live?: boolean;
}

const { class: className = "", live = false } = Astro.props;
---

<span class:list={["brandmark group/brand inline-flex items-baseline font-display leading-none", className]}>
  <span class="font-extrabold tracking-[-0.05em]" style="font-stretch: 75%">ellipsis</span>
  <span aria-hidden="true" class:list={["ml-[0.06em] inline-flex gap-[0.08em]", live && "dots"]}>
    <span class="size-[0.17em] rounded-full bg-current"></span>
    <span class="size-[0.17em] rounded-full bg-current"></span>
    <span class="size-[0.17em] rounded-full bg-mark"></span>
  </span>
</span>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .brandmark:hover > span:last-child > span {
      animation: dot-pulse 1.4s ease-in-out infinite both;
    }

    .brandmark:hover > span:last-child > span:nth-child(2) {
      animation-delay: 0.2s;
    }

    .brandmark:hover > span:last-child > span:nth-child(3) {
      animation-delay: 0.4s;
    }
  }
</style>
