---
// A photo taped into the notebook, with a figure caption underneath.
import { sized } from "../data/site";

interface Props {
  src: string;
  alt: string;
  fig: string;
  caption: string;
  width?: number;
  height?: number;
  rotate?: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, fig, caption, width = 900, height = 640, rotate = 2, eager = false, class: className = "" } = Astro.props;
---

<figure class:list={[!eager && "settle", "relative", className]} style={`rotate:${rotate}deg; --settle-from:${rotate * -3}deg`}>
  <div class="tape relative rounded-[0.35rem] border-[1.5px] border-fg bg-page p-2.5 pb-3 shadow-[5px_5px_0_var(--color-fg)]">
    <img
      src={sized(src, width, height)}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class="block h-auto w-full rounded-[0.2rem] object-cover"
    />
    <figcaption class="mt-3 flex gap-3 px-1 text-[0.72rem] leading-snug">
      <span class="label shrink-0 text-mark">Fig. {fig}</span>
      <span class="font-mono text-muted">{caption}</span>
    </figcaption>
  </div>
</figure>
